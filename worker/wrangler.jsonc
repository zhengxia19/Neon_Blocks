// Neon_Blocks 联网对战 Worker 配置（N08）。
// 边界：不迁移前端静态资源（GitHub Pages 工作流保持原样）；单 SQLite-backed DO 绑定。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neon-blocks-room-api",
  "main": "src/index.ts",
  // 显式兼容日期（清单 N08 要求；不使用隐式默认）
  "compatibility_date": "2026-10-01",
  // 公开 API 原点：workers.dev 子域名（正式路由/自定义域属 N44 部署阶段）
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  // 当前 Wrangler 规范：SQLite-backed DO 用 new_sqlite_classes 迁移声明
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  "vars": {
    // CORS/Origin 白名单（逗号分隔）：正式仅 GitHub Pages 站点；本地开发白名单在
    // src/cors.ts 中仅当 ALLOW_DEV_ORIGINS="true"（仅本地模拟/测试设置）时并入。
    "ALLOWED_ORIGINS": "https://zhengxia19.github.io",
    // N22 防滥用限额（每 IP / 60 秒滑动窗口）。注意：Worker 内桶为**每实例（isolate/colo）**
    // 计数，非全局分布式；跨实例分布式 IP 限流由 Cloudflare Rate Limiting Rules 承担
    // （配置/依赖见 evidence/multiplayer/N22/rate-limit-rules.md）。
    "CREATE_RATE_LIMIT_PER_MIN": "30",
    "JOIN_RATE_LIMIT_PER_MIN": "30",
    "TICKET_RATE_LIMIT_PER_MIN": "60",
    // 试码冷却：join/ticket/ws 对不存在房间或伪造票据的失败共享该预算。
    "CODE_PROBE_LIMIT_PER_MIN": "20",
    // 生产创建开关：若分布式 IP 限流未落实需止损，置 "false" → POST /api/rooms 返回
    // 503 CREATE_DISABLED（正常好友 join 已有房间不受影响）。
    "PUBLIC_CREATE_ENABLED": "true"
  }
}
